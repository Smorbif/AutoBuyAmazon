# Copy to .env and set a long random value. The webhook listens only on localhost.
HOOK_SECRET=replace-with-a-long-random-secret
PORT=8787
AMAZON_HOST=www.amazon.it
PROFILE_DIR=./data/amazon-profile
KEEPA_PROFILE_DIR=./data/keepa-profile

# Sorgente degli avvisi: telegram oppure keepa-web (pagina Keepa > Tracking > Notifiche recenti).
NOTIFICATION_SOURCE=telegram

# Keep false during setup. Abilita gli acquisti dal pannello solo dopo aver verificato
# l'account Amazon e la sorgente selezionata (mittente Keepa per Telegram).
AUTO_BUY=false

# Telegram user-client API credentials (create an app at my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
KEEPA_SENDER_ID=

# Optional: browser defaults to the installed Playwright Chromium.
HEADLESS=false
